generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Gender {
  UNKNOWN
  MALE
  FEMALE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  OFFLINE
}

enum FeedbackStatus {
  PENDING
  PROCESSING
  RESOLVED
  CLOSED
}

enum LedgerType {
  SIGNIN
  INVITE
  TASK
  AD
  SHARE
  WITHDRAW
  ADJUSTMENT
}

enum WithdrawalStatus {
  PENDING
  PAYING
  COMPLETED
  REJECTED
  FAILED
}

enum WithdrawalChannel {
  ALIPAY
  WECHAT
  BANK
}

enum WithdrawalBatchStatus {
  DRAFT
  EXPORTED
  PROCESSING
  PARTIAL
  COMPLETED
  CLOSED
}

enum WithdrawalBatchItemStatus {
  PENDING
  SUCCESS
  FAILED
}

enum OperationPlacement {
  HOME_BANNER
  HOME_RECOMMEND
  STARTUP_POPUP
}

enum OperationTargetType {
  NONE
  CONTENT
  INTERNAL
  EXTERNAL
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  OFFLINE
}

enum AppPlatform {
  ANDROID
  IOS
}

enum RiskStatus {
  NORMAL
  WATCH
  REWARD_RESTRICTED
  WITHDRAWAL_RESTRICTED
  FROZEN
  BANNED
}

enum ReportStatus {
  PENDING
  PROCESSING
  VALID
  INVALID
  CLOSED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskEventStatus {
  PENDING
  CONFIRMED
  IGNORED
}

enum ReconciliationStatus {
  RUNNING
  PASSED
  FAILED
}

/// App 用户与后台管理员共用账号表，后台能力由 roles 关系决定，不使用固定身份字段。
model User {
  id                        BigInt                    @id @default(autoincrement())
  phone                     String                    @unique @db.VarChar(20)
  passwordHash              String?                   @map("password_hash") @db.VarChar(255)
  nickname                  String                    @db.VarChar(50)
  avatarUrl                 String?                   @map("avatar_url") @db.VarChar(500)
  gender                    Gender                    @default(UNKNOWN)
  birthday                  DateTime?                 @db.Date
  bio                       String?                   @db.VarChar(500)
  status                    UserStatus                @default(ACTIVE)
  riskStatus                RiskStatus                @default(NORMAL) @map("risk_status")
  riskRemark                String?                   @map("risk_remark") @db.VarChar(500)
  coinBalance               BigInt                    @default(0) @map("coin_balance")
  frozenCoinBalance         BigInt                    @default(0) @map("frozen_coin_balance")
  inviteCode                String?                   @unique @map("invite_code") @db.VarChar(12)
  /// 广告分成万分比；null 表示继承全局配置，10000 表示 100%。
  adShareRateBps            Int?                      @map("ad_share_rate_bps")
  /// 代理无限下级广告返佣万分比；仅管理员创建的代理账号可设置。
  agentShareRateBps         Int?                      @map("agent_share_rate_bps")
  createdAt                 DateTime                  @default(now()) @map("created_at")
  updatedAt                 DateTime                  @updatedAt @map("updated_at")
  favorites                 Favorite[]
  histories                 WatchHistory[]
  playbackValidations       DramaPlaybackValidation[]
  ledgers                   RewardLedger[]
  feedback                  Feedback[]
  notifications             UserNotification[]
  roles                     UserRole[]
  refreshTokens             RefreshToken[]
  invitesSent               InviteRelation[]          @relation("InviteRelationInviter")
  invitedBy                 InviteRelation?           @relation("InviteRelationInvitee")
  checkIns                  CheckIn[]
  goldenWatchProgress       GoldenWatchProgress[]
  sdkLibrarySyncs           SdkLibrarySync[]
  withdrawals               Withdrawal[]
  payoutAccount             PayoutAccount?
  reports                   Report[]
  loginLogs                 LoginLog[]
  devices                   UserDevice[]
  riskEvents                RiskEvent[]
  riskAssessments           DeviceRiskAssessment[]
  locationPresences         DeviceLocationPresence[]
  riskChallenges            DeviceRiskChallenge[]
  adRewardSettlements       AdRewardSettlement[]
  agentCommissions          AgentAdCommission[]       @relation("AgentCommissionReceiver")
  generatedAgentCommissions AgentAdCommission[]       @relation("AgentCommissionSource")

  @@map("users")
}

/// 用户预先绑定的提现收款账户；完整姓名和账号使用 AES-256-GCM 密文保存。
model PayoutAccount {
  id             BigInt            @id @default(autoincrement())
  userId         BigInt            @unique @map("user_id")
  channel        WithdrawalChannel
  accountCipher  String            @map("account_cipher") @db.Text
  accountMasked  String            @map("account_masked") @db.VarChar(100)
  realNameCipher String            @map("real_name_cipher") @db.Text
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payout_accounts")
}

/// 广告分成全局配置；金额换算复用 WithdrawalConfig.coinsPerCent。
model AdRewardConfig {
  id                         Int      @id @default(1)
  defaultShareRateBps        Int      @default(5000) @map("default_share_rate_bps")
  directShareRateBps         Int      @default(0) @map("direct_share_rate_bps")
  indirectShareRateBps       Int      @default(0) @map("indirect_share_rate_bps")
  splashRewardEnabled        Boolean  @default(false) @map("splash_reward_enabled")
  feedRewardEnabled          Boolean  @default(false) @map("feed_reward_enabled")
  fullScreenRewardEnabled    Boolean  @default(false) @map("full_screen_reward_enabled")
  rewardedVideoRewardEnabled Boolean  @default(true) @map("rewarded_video_reward_enabled")
  dramaUnlockRewardEnabled   Boolean  @default(true) @map("drama_unlock_reward_enabled")
  /// 激励广告阶梯；JSON 数组元素为 { count, rewardCoins, period }，由后台动态配置。
  rewardedAdMilestones       Json?    @map("rewarded_ad_milestones")
  /// 有效直邀阶梯；支持 DAILY 与 LIFETIME 两种统计周期。
  inviteMilestones           Json?    @map("invite_milestones")
  /// 单个用户按北京时间自然日最多可结算的 GroMore 激励广告次数。
  dailyRewardedAdLimit       Int      @default(5) @map("daily_rewarded_ad_limit")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("ad_reward_config")
}

/// 单次广告收入结算快照；requestId 唯一保证穿山甲重复回调不会重复发币。
model AdRewardSettlement {
  id                   String              @id @default(uuid()) @db.VarChar(36)
  requestId            String              @unique @map("request_id") @db.VarChar(100)
  userId               BigInt              @map("user_id")
  revenueMicros        BigInt              @map("revenue_micros")
  shareRateBps         Int                 @map("share_rate_bps")
  coinsPerCent         Int                 @map("coins_per_cent")
  baseUserCoins        BigInt              @default(0) @map("base_user_coins")
  awardedCoins         BigInt              @map("awarded_coins")
  milestoneBonusCoins  BigInt              @default(0) @map("milestone_bonus_coins")
  directInviterId      BigInt?             @map("direct_inviter_id")
  indirectInviterId    BigInt?             @map("indirect_inviter_id")
  directShareRateBps   Int                 @default(0) @map("direct_share_rate_bps")
  indirectShareRateBps Int                 @default(0) @map("indirect_share_rate_bps")
  directAwardedCoins   BigInt              @default(0) @map("direct_awarded_coins")
  indirectAwardedCoins BigInt              @default(0) @map("indirect_awarded_coins")
  /// USER_DEDUCTED 为历史拆分记录；PLATFORM_FUNDED 表示返佣由平台额外承担。
  commissionFunding    String              @default("PLATFORM_FUNDED") @map("commission_funding") @db.VarChar(20)
  format               String              @default("REWARD") @db.VarChar(20)
  source               String              @default("PANGLE") @db.VarChar(30)
  createdAt            DateTime            @default(now()) @map("created_at")
  user                 User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  agentCommissions     AgentAdCommission[]

  @@index([userId, createdAt])
  @@index([format, createdAt])
  @@map("ad_reward_settlements")
}

/// 代理从任意深度下级广告收益中获得的平台额外佣金；比例和金额均按结算时快照保存。
model AgentAdCommission {
  id           String             @id @default(uuid()) @db.VarChar(36)
  settlementId String             @map("settlement_id") @db.VarChar(36)
  agentId      BigInt             @map("agent_id")
  sourceUserId BigInt             @map("source_user_id")
  depth        Int
  shareRateBps Int                @map("share_rate_bps")
  awardedCoins BigInt             @map("awarded_coins")
  createdAt    DateTime           @default(now()) @map("created_at")
  settlement   AdRewardSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  agent        User               @relation("AgentCommissionReceiver", fields: [agentId], references: [id], onDelete: Restrict)
  sourceUser   User               @relation("AgentCommissionSource", fields: [sourceUserId], references: [id], onDelete: Restrict)

  @@unique([settlementId, agentId])
  @@index([agentId, createdAt])
  @@index([sourceUserId, createdAt])
  @@map("agent_ad_commissions")
}

/// 广告平台回调接收日志；成功和失败请求均保留，便于审计与问题追踪。
model AdCallbackLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  eventId   String   @unique @map("event_id") @db.VarChar(100)
  status    String   @db.VarChar(20)
  reason    String?  @db.VarChar(500)
  payload   Json
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("ad_callback_logs")
}

/// 提现规则使用单行配置；金额以金币或人民币分为单位，避免浮点精度问题。
model WithdrawalConfig {
  id              Int      @id @default(1)
  enabled         Boolean  @default(true)
  coinsPerCent    Int      @default(100) @map("coins_per_cent")
  minCoins        BigInt   @default(10000) @map("min_coins")
  maxCoins        BigInt   @default(1000000) @map("max_coins")
  tiers           Json     @map("tiers")
  dailyCountLimit Int      @default(3) @map("daily_count_limit")
  dailyCoinLimit  BigInt   @default(2000000) @map("daily_coin_limit")
  feeRateBps      Int      @default(0) @map("fee_rate_bps")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("withdrawal_config")
}

/// 提现订单保存加密收款信息和脱敏展示值，状态只能通过业务状态机迁移。
model Withdrawal {
  id               String               @id @default(uuid()) @db.VarChar(36)
  requestId        String               @unique @map("request_id") @db.VarChar(64)
  userId           BigInt               @map("user_id")
  coins            BigInt
  amountCents      Int                  @map("amount_cents")
  feeCents         Int                  @map("fee_cents")
  actualCents      Int                  @map("actual_cents")
  channel          WithdrawalChannel
  accountCipher    String               @map("account_cipher") @db.Text
  accountMasked    String               @map("account_masked") @db.VarChar(100)
  realNameCipher   String               @map("real_name_cipher") @db.Text
  status           WithdrawalStatus     @default(PENDING)
  reviewRemark     String?              @map("review_remark") @db.VarChar(500)
  paymentReference String?              @map("payment_reference") @db.VarChar(100)
  reviewedBy       BigInt?              @map("reviewed_by")
  reviewedAt       DateTime?            @map("reviewed_at")
  completedAt      DateTime?            @map("completed_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  user             User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  batchItem        WithdrawalBatchItem?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("withdrawals")
}

/// 财务打款批次汇总；requestId 用于防止重复提交，批次号供导出文件和支付平台回传使用。
model WithdrawalBatch {
  id              String                @id @default(uuid()) @db.VarChar(36)
  batchNo         String                @unique @map("batch_no") @db.VarChar(40)
  requestId       String                @unique @map("request_id") @db.VarChar(64)
  resultRequestId String?               @unique @map("result_request_id") @db.VarChar(64)
  status          WithdrawalBatchStatus @default(DRAFT)
  orderCount      Int                   @map("order_count")
  totalCents      Int                   @map("total_cents")
  createdBy       BigInt                @map("created_by")
  remark          String?               @db.VarChar(500)
  exportedAt      DateTime?             @map("exported_at")
  completedAt     DateTime?             @map("completed_at")
  closedAt        DateTime?             @map("closed_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  items           WithdrawalBatchItem[]

  @@index([status, createdAt])
  @@map("withdrawal_batches")
}

/// 批次明细与提现订单一对一，数据库唯一约束从根源避免订单重复进入打款批次。
model WithdrawalBatchItem {
  id               BigInt                    @id @default(autoincrement())
  batchId          String                    @map("batch_id") @db.VarChar(36)
  withdrawalId     String                    @unique @map("withdrawal_id") @db.VarChar(36)
  status           WithdrawalBatchItemStatus @default(PENDING)
  paymentReference String?                   @map("payment_reference") @db.VarChar(100)
  failureReason    String?                   @map("failure_reason") @db.VarChar(500)
  processedAt      DateTime?                 @map("processed_at")
  batch            WithdrawalBatch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  withdrawal       Withdrawal                @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)

  @@index([batchId, status])
  @@map("withdrawal_batch_items")
}

/// 邀请关系一经绑定不可修改；inviteeId 唯一保证每个用户只能绑定一次邀请人。
model InviteRelation {
  id         BigInt   @id @default(autoincrement())
  inviterId  BigInt   @map("inviter_id")
  inviteeId  BigInt   @unique @map("invitee_id")
  inviteCode String   @map("invite_code") @db.VarChar(12)
  createdAt  DateTime @default(now()) @map("created_at")
  inviter    User     @relation("InviteRelationInviter", fields: [inviterId], references: [id], onDelete: Restrict)
  invitee    User     @relation("InviteRelationInvitee", fields: [inviteeId], references: [id], onDelete: Restrict)

  @@index([inviterId, createdAt])
  @@map("invite_relations")
}

/// 奖励规则由后台维护，业务代码只引用稳定 code，金额调整无需重新发布服务。
model RewardRule {
  code        String   @id @db.VarChar(50)
  name        String   @db.VarChar(80)
  amount      BigInt
  enabled     Boolean  @default(true)
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("reward_rules")
}

/// 每日签到以用户和业务日期为唯一键，防止重复请求产生重复奖励。
model CheckIn {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  date      DateTime @db.Date
  streak    Int
  reward    BigInt
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, date])
  @@index([date, createdAt])
  @@map("check_ins")
}

/// 黄金时段有效观剧的每日进度；服务端按递增心跳累计，completedAt 保证每天最多结算一次。
model GoldenWatchProgress {
  id              BigInt    @id @default(autoincrement())
  userId          BigInt    @map("user_id")
  date            DateTime  @db.Date
  watchedSeconds  Int       @default(0) @map("watched_seconds")
  sessionId       String?   @map("session_id") @db.VarChar(64)
  sessionSeconds  Int       @default(0) @map("session_seconds")
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  completedAt     DateTime? @map("completed_at")
  reward          BigInt    @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, date])
  @@index([date, completedAt])
  @@map("golden_watch_progress")
}

/// RBAC 角色：一个账号可以拥有多个角色。
model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(50)
  description String?          @db.VarChar(200)
  isSystem    Boolean          @default(false) @map("is_system")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

/// 权限码同时用于服务端鉴权、后台菜单显示和按钮显隐。
model Permission {
  id     Int              @id @default(autoincrement())
  code   String           @unique @db.VarChar(100)
  name   String           @db.VarChar(80)
  module String           @db.VarChar(50)
  roles  RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId BigInt @map("user_id")
  roleId Int    @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// 短剧主数据；播放地址按集存放在 Episode，草稿不会出现在 App API。
model Drama {
  id                   BigInt                    @id @default(autoincrement())
  /// 内容来源；LOCAL 为后台维护内容，PANGLE 为穿山甲内容输出同步快照。
  provider             String                    @default("LOCAL") @db.VarChar(30)
  /// 第三方内容 ID。与 provider 组成唯一键，供原生播放器打开真实内容。
  externalId           String?                   @map("external_id") @db.VarChar(100)
  externalEpisodeCount Int                       @default(0) @map("external_episode_count")
  title                String                    @db.VarChar(150)
  description          String?                   @db.Text
  coverUrl             String                    @map("cover_url") @db.VarChar(500)
  category             String                    @db.VarChar(50)
  tags                 Json?
  actors               Json?
  status               ContentStatus             @default(DRAFT)
  sort                 Int                       @default(0)
  viewCount            BigInt                    @default(0) @map("view_count")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  episodes             Episode[]
  favorites            Favorite[]
  histories            WatchHistory[]
  playbackValidations  DramaPlaybackValidation[]

  @@unique([provider, externalId])
  @@index([status, category, sort])
  @@map("dramas")
}

model Episode {
  id          BigInt         @id @default(autoincrement())
  dramaId     BigInt         @map("drama_id")
  episodeNo   Int            @map("episode_no")
  title       String         @db.VarChar(150)
  videoUrl    String         @map("video_url") @db.VarChar(1000)
  durationSec Int            @default(0) @map("duration_sec")
  status      ContentStatus  @default(DRAFT)
  drama       Drama          @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  histories   WatchHistory[]

  @@unique([dramaId, episodeNo])
  @@map("episodes")
}

model Favorite {
  userId    BigInt   @map("user_id")
  dramaId   BigInt   @map("drama_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  drama     Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)

  @@id([userId, dramaId])
  @@map("favorites")
}

model WatchHistory {
  id              BigInt   @id @default(autoincrement())
  userId          BigInt   @map("user_id")
  dramaId         BigInt   @map("drama_id")
  episodeId       BigInt   @map("episode_id")
  positionSeconds Int      @default(0) @map("position_seconds")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  drama           Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  episode         Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, dramaId])
  @@index([userId, updatedAt])
  @@map("watch_histories")
}

/// 穿山甲播放器关闭后的资料库增量同步凭证；requestId 保证重试不会重复应用旧差异。
model SdkLibrarySync {
  requestId String   @id @map("request_id") @db.VarChar(64)
  userId    BigInt   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("sdk_library_syncs")
}

/// ARM 真机通过 Pangrowth 原生 SDK 请求内容并实际开始播放的验证证据。
model DramaPlaybackValidation {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  dramaId            BigInt    @map("drama_id")
  userId             BigInt    @map("user_id")
  deviceHash         String    @map("device_hash") @db.Char(64)
  deviceModel        String?   @map("device_model") @db.VarChar(100)
  abi                String?   @db.VarChar(50)
  sdkVersion         String?   @map("sdk_version") @db.VarChar(30)
  appVersion         String?   @map("app_version") @db.VarChar(30)
  requestSucceededAt DateTime? @map("request_succeeded_at")
  playbackStartedAt  DateTime? @map("playback_started_at")
  lastEventAt        DateTime  @default(now()) @map("last_event_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  drama              Drama     @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dramaId, deviceHash])
  @@index([playbackStartedAt])
  @@index([userId, updatedAt])
  @@map("drama_playback_validations")
}

/// 不可变金币流水。bizId 是外部业务幂等号，余额变化必须与流水在同一事务完成。
model RewardLedger {
  id           BigInt     @id @default(autoincrement())
  userId       BigInt     @map("user_id")
  type         LedgerType
  amount       BigInt
  balanceAfter BigInt     @default(0) @map("balance_after")
  title        String     @db.VarChar(100)
  bizId        String?    @map("biz_id") @db.VarChar(100)
  createdAt    DateTime   @default(now()) @map("created_at")
  user         User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([type, bizId])
  @@index([userId, createdAt])
  @@map("reward_ledgers")
}

model Feedback {
  id           BigInt         @id @default(autoincrement())
  userId       BigInt?        @map("user_id")
  type         String         @db.VarChar(30)
  content      String         @db.Text
  contact      String?        @db.VarChar(100)
  imageUrls    Json?          @map("image_urls")
  status       FeedbackStatus @default(PENDING)
  reply        String?        @db.Text
  handlerId    BigInt?        @map("handler_id")
  internalNote String?        @map("internal_note") @db.Text
  resolvedAt   DateTime?      @map("resolved_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("feedback")
}

model Report {
  id           BigInt       @id @default(autoincrement())
  userId       BigInt       @map("user_id")
  type         String       @db.VarChar(30)
  targetType   String       @map("target_type") @db.VarChar(30)
  targetId     String?      @map("target_id") @db.VarChar(100)
  content      String       @db.Text
  evidenceUrls Json?        @map("evidence_urls")
  status       ReportStatus @default(PENDING)
  handlerId    BigInt?      @map("handler_id")
  disposition  String?      @db.VarChar(100)
  remark       String?      @db.Text
  resolvedAt   DateTime?    @map("resolved_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("reports")
}

model LoginLog {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt?  @map("user_id")
  account     String   @db.VarChar(50)
  success     Boolean
  failureCode String?  @map("failure_code") @db.VarChar(50)
  ip          String?  @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  deviceId    String?  @map("device_id") @db.VarChar(100)
  appVersion  String?  @map("app_version") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([ip, createdAt])
  @@index([deviceId, createdAt])
  @@map("login_logs")
}

model UserDevice {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  deviceId    String   @map("device_id") @db.VarChar(100)
  platform    String?  @db.VarChar(30)
  appVersion  String?  @map("app_version") @db.VarChar(30)
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([deviceId, lastSeenAt])
  @@map("user_devices")
}

model RiskEvent {
  id        BigInt          @id @default(autoincrement())
  userId    BigInt?         @map("user_id")
  ruleCode  String          @map("rule_code") @db.VarChar(80)
  level     RiskLevel
  title     String          @db.VarChar(150)
  detail    Json?
  status    RiskEventStatus @default(PENDING)
  handlerId BigInt?         @map("handler_id")
  remark    String?         @db.VarChar(500)
  handledAt DateTime?       @map("handled_at")
  createdAt DateTime        @default(now()) @map("created_at")
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, level, createdAt])
  @@index([userId, createdAt])
  @@map("risk_events")
}

/// 客户端环境检测快照。评分由服务端重新计算，原始检测项仅作为风控证据，不能替代平台证明或设备证明。
model DeviceRiskAssessment {
  id                     String   @id @default(uuid()) @db.VarChar(36)
  userId                 BigInt   @map("user_id")
  deviceId               String   @map("device_id") @db.VarChar(100)
  score                  Int
  knownChecks            Int      @default(10) @map("known_checks")
  autoBanned             Boolean  @default(false) @map("auto_banned")
  simPresent             Boolean? @map("sim_present")
  wechatInstalled        Boolean? @map("wechat_installed")
  douyinInstalled        Boolean? @map("douyin_installed")
  alipayInstalled        Boolean? @map("alipay_installed")
  emulatorDetected       Boolean? @map("emulator_detected")
  cloudDeviceDetected    Boolean? @map("cloud_device_detected")
  scriptDetected         Boolean? @map("script_detected")
  networkTrusted         Boolean? @map("network_trusted")
  ipTrusted              Boolean? @map("ip_trusted")
  locationDistanceSafe   Boolean? @map("location_distance_safe")
  distanceMeters         Int?     @map("distance_meters")
  locationClusterSafe    Boolean? @map("location_cluster_safe")
  nearbyDeviceCount      Int?     @map("nearby_device_count")
  nearbyRadiusMeters     Int?     @map("nearby_radius_meters")
  presenceWindowMinutes  Int?     @map("presence_window_minutes")
  locationAccuracyMeters Float?   @map("location_accuracy_meters")
  locationMock           Boolean? @map("location_mock")
  ip                     String?  @db.VarChar(64)
  detail                 Json?
  createdAt              DateTime @default(now()) @map("created_at")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([score, createdAt])
  @@map("device_risk_assessments")
}

/// APP 活跃设备的短期位置。deviceId 是应用内哈希安装标识，原始 Android ID 不会入库。
/// 该表只用于附近设备聚集统计，过期记录由每次风控检测清理。
model DeviceLocationPresence {
  id             String   @id @default(uuid()) @db.VarChar(36)
  userId         BigInt   @map("user_id")
  deviceId       String   @unique @map("device_id") @db.VarChar(100)
  latitude       Float
  longitude      Float
  accuracyMeters Float    @map("accuracy_meters")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastSeenAt])
  @@index([latitude, longitude])
  @@map("device_location_presences")
}

/// 服务端签发的一次性设备检测挑战，使用后立即失效，阻止旧检测包重复提交。
model DeviceRiskChallenge {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    BigInt    @map("user_id")
  context   String    @db.VarChar(20)
  nonce     String    @unique @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("device_risk_challenges")
}

/// 每次对账保留汇总结果，便于监控任务执行状态和历史趋势。
model ReconciliationRun {
  id           String                @id @default(uuid()) @db.VarChar(36)
  source       String                @default("MANUAL") @db.VarChar(20)
  scheduleKey  String?               @unique @map("schedule_key") @db.VarChar(50)
  status       ReconciliationStatus  @default(RUNNING)
  checkedUsers Int                   @default(0) @map("checked_users")
  issueCount   Int                   @default(0) @map("issue_count")
  startedAt    DateTime              @default(now()) @map("started_at")
  completedAt  DateTime?             @map("completed_at")
  errorMessage String?               @map("error_message") @db.Text
  issues       ReconciliationIssue[]

  @@index([startedAt])
  @@map("reconciliation_runs")
}

/// 对账差异只记录不自动修复，必须由人工结合流水和订单确认。
model ReconciliationIssue {
  id             BigInt            @id @default(autoincrement())
  runId          String            @map("run_id") @db.VarChar(36)
  userId         BigInt            @map("user_id")
  type           String            @db.VarChar(50)
  actualAmount   BigInt            @map("actual_amount")
  expectedAmount BigInt            @map("expected_amount")
  difference     BigInt
  createdAt      DateTime          @default(now()) @map("created_at")
  run            ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("reconciliation_issues")
}

model Notification {
  id        BigInt             @id @default(autoincrement())
  title     String             @db.VarChar(150)
  content   String             @db.Text
  type      String             @db.VarChar(30)
  createdAt DateTime           @default(now()) @map("created_at")
  users     UserNotification[]

  @@map("notifications")
}

model UserNotification {
  userId         BigInt       @map("user_id")
  notificationId BigInt       @map("notification_id")
  readAt         DateTime?    @map("read_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([userId, notificationId])
  @@map("user_notifications")
}

/// 只保存刷新令牌摘要，不保存可直接使用的原始令牌。
model RefreshToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

/// 注册短信验证码。只保存 HMAC 摘要，验证码成功注册后立即标记为已使用。
model SmsVerificationCode {
  id         String    @id @default(uuid()) @db.VarChar(36)
  phone      String    @db.VarChar(20)
  purpose    String    @db.VarChar(30)
  codeHash   String    @map("code_hash") @db.Char(64)
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  providerId String?   @map("provider_id") @db.VarChar(100)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
  @@map("sms_verification_codes")
}

model SystemConfig {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

/// 客户端广告生命周期埋点；仅用于运营统计，不参与金币结算。
model AdClientEvent {
  id           String   @id @default(uuid()) @db.VarChar(36)
  format       String   @db.VarChar(30)
  eventType    String   @map("event_type") @db.VarChar(30)
  placementId  String   @map("placement_id") @db.VarChar(50)
  requestId    String?  @map("request_id") @db.VarChar(100)
  creativeId   String?  @map("creative_id") @db.VarChar(100)
  adnName      String?  @map("adn_name") @db.VarChar(50)
  ecpm         Decimal? @db.Decimal(14, 4)
  errorMessage String?  @map("error_message") @db.VarChar(500)
  deviceHash   String?  @map("device_hash") @db.Char(64)
  platform     String?  @db.VarChar(30)
  appVersion   String?  @map("app_version") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([format, eventType, createdAt])
  @@index([placementId, createdAt])
  @@index([deviceHash, createdAt])
  @@map("ad_client_events")
}

/// 上传文件的元数据；存储路径与业务引用分离，便于后续切换 OSS/COS。
model MediaAsset {
  id           String   @id @default(uuid()) @db.VarChar(36)
  originalName String   @map("original_name") @db.VarChar(255)
  storageKey   String   @unique @map("storage_key") @db.VarChar(500)
  url          String   @db.VarChar(1000)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  size         Int
  uploaderId   BigInt?  @map("uploader_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([uploaderId, createdAt])
  @@map("media_assets")
}

/// 首页轮播、推荐位和启动弹窗共用结构，通过 placement 区分展示位置。
model OperationSlot {
  id          BigInt              @id @default(autoincrement())
  placement   OperationPlacement
  title       String              @db.VarChar(100)
  imageUrl    String              @map("image_url") @db.VarChar(1000)
  targetType  OperationTargetType @default(NONE) @map("target_type")
  targetValue String?             @map("target_value") @db.VarChar(1000)
  sort        Int                 @default(0)
  enabled     Boolean             @default(true)
  startAt     DateTime?           @map("start_at")
  endAt       DateTime?           @map("end_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@index([placement, enabled, sort])
  @@map("operation_slots")
}

model Announcement {
  id        BigInt        @id @default(autoincrement())
  title     String        @db.VarChar(150)
  content   String        @db.Text
  status    PublishStatus @default(DRAFT)
  startAt   DateTime?     @map("start_at")
  endAt     DateTime?     @map("end_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([status, startAt, endAt])
  @@map("announcements")
}

/// 同一协议可以保留多个版本；App 按 code 获取当前已发布版本。
model AppDocument {
  id          BigInt        @id @default(autoincrement())
  code        String        @db.VarChar(50)
  title       String        @db.VarChar(150)
  version     String        @db.VarChar(30)
  content     String        @db.LongText
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([code, version])
  @@index([code, status, publishedAt])
  @@map("app_documents")
}

model AppVersion {
  id             BigInt      @id @default(autoincrement())
  platform       AppPlatform
  versionName    String      @map("version_name") @db.VarChar(30)
  versionCode    Int         @map("version_code")
  minVersionCode Int         @map("min_version_code")
  downloadUrl    String      @map("download_url") @db.VarChar(1000)
  releaseNotes   String      @map("release_notes") @db.Text
  enabled        Boolean     @default(true)
  rolloutPercent Int         @default(100) @map("rollout_percent")
  publishedAt    DateTime?   @map("published_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@unique([platform, versionCode])
  @@index([platform, enabled, publishedAt])
  @@map("app_versions")
}

/// 后台敏感操作审计记录。业务数据变更应与日志放进同一数据库事务。
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  operatorId BigInt?  @map("operator_id")
  action     String   @db.VarChar(100)
  method     String   @db.VarChar(10)
  path       String   @db.VarChar(255)
  targetType String?  @map("target_type") @db.VarChar(50)
  targetId   String?  @map("target_id") @db.VarChar(100)
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([operatorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
