NODE_ENV=development
API_DOCS_ENABLED=true
PORT=3000
APP_BRAND_NAME=富商剧场
DATABASE_URL="mysql://root:password@127.0.0.1:3306/hanle_theater"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-another-32-random-characters"
ACCESS_TOKEN_EXPIRES_IN=15m
# 管理后台访问令牌有效期；后台还会使用刷新令牌静默续签。
ADMIN_ACCESS_TOKEN_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=30d
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ADMIN_INITIAL_PASSWORD=ChangeMe123!
PANGLE_REWARD_SECURITY_KEY=replace-with-gromore-m-key
PANGLE_RSS_PRIVATE_KEY="replace-with-rss-private-key-pem"
PANGLE_GROMORE_APP_ID=5879132
PANGLE_GROMORE_REWARDED_PLACEMENT_ID=104489019
PANGLE_CONTENT_SERVER_KEY=replace-with-content-output-server-key
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=""
ALIPAY_APP_CERT_PATH=certs/appCertPublicKey.crt
ALIPAY_PUBLIC_CERT_PATH=certs/alipayCertPublicKey_RSA2.crt
ALIPAY_ROOT_CERT_PATH=certs/alipayRootCert.crt
ALIPAY_KEY_TYPE=PKCS8
ALIPAY_ENDPOINT=https://openapi.alipay.com
# 必须与支付宝商家平台“资金管理 - 转账场景”中已申报通过的名称一致
ALIPAY_TRANSFER_SCENE_NAME=现金营销
# 阿里云短信：使用已审核通过的签名和验证码模板，模板变量名需为 code
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_REGISTER_TEMPLATE_CODE=SMS_XXXXXXXXX
SMS_CODE_TTL_SECONDS=300
SMS_CODE_RESEND_SECONDS=60
SMS_CODE_MAX_ATTEMPTS=5
UPLOAD_DIRECTORY=uploads
UPLOAD_MAX_IMAGE_MB=5
