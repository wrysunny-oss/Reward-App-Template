{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product-config.schema.json",
  "title": "富商剧场产品配置",
  "description": "三端共享的非敏感产品配置。修改后运行 node scripts/sync-product-config.mjs。密码、私钥和 AccessKey 禁止写入此文件。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "productCode", "brand", "android", "admin", "modules", "domains", "advertising"],
  "properties": {
    "$schema": { "type": "string", "description": "为 VS Code 提供字段说明和格式检查，不需要修改。" },
    "schemaVersion": { "const": 1, "description": "配置结构版本。当前只能填写 1，不是 APP 版本号。" },
    "productCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "产品内部英文标识，用于脚本和资源命名。建议全小写，发布后不要随意修改。",
      "examples": ["fushang-theater"]
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appDisplayName", "adminTitle", "adminDescription", "companyName", "sdkAppName"],
      "properties": {
        "appDisplayName": { "type": "string", "minLength": 1, "description": "用户看到的 APP 名称，同时同步到 Android 和 iOS。" },
        "adminTitle": { "type": "string", "minLength": 1, "description": "管理后台左上角、登录页和浏览器标题使用的名称。" },
        "adminDescription": { "type": "string", "minLength": 1, "description": "管理后台的产品说明和页面元信息。" },
        "companyName": { "type": "string", "minLength": 1, "description": "协议、关于页面等位置展示的运营公司名称。" },
        "sdkAppName": { "type": "string", "minLength": 1, "description": "穿山甲/GroMore SDK 后台登记的应用名，可以与 APP 展示名不同。" }
      }
    },
    "android": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicationId"],
      "properties": {
        "applicationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
          "description": "Android 安装包唯一标识。修改后会被视为一个新应用，正式发布后不要随意更改。",
          "examples": ["com.company.theater"]
        }
      }
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1, "description": "管理后台浏览器缓存和本地存储的命名空间。复制成新项目时必须修改，避免不同后台互相污染缓存。" }
      }
    },
    "modules": {
      "type": "object",
      "description": "模板级业务模块清单。第一阶段用于三端识别能力；关闭模块前应确认相关页面和接口已经完成开关接管。",
      "additionalProperties": false,
      "required": ["shortDrama", "advertising", "rewards", "invitations", "smsRegistration", "withdrawals", "alipayPayout"],
      "properties": {
        "shortDrama": { "type": "boolean", "description": "是否启用短剧内容、播放器和短剧 SDK。" },
        "advertising": { "type": "boolean", "description": "是否启用 GroMore 广告加载、展示和广告事件。" },
        "rewards": { "type": "boolean", "description": "是否启用金币、签到、激励广告收益和收益流水。邀请和提现模块依赖它。" },
        "invitations": { "type": "boolean", "description": "是否启用邀请码、邀请关系、分享页和邀请阶梯任务；启用时 rewards 必须同时开启。" },
        "smsRegistration": { "type": "boolean", "description": "是否启用阿里云短信验证码注册。关闭前必须先实现另一种注册验证方式。" },
        "withdrawals": { "type": "boolean", "description": "是否启用用户提现、收款账户和后台提现审核；启用时 rewards 必须同时开启。" },
        "alipayPayout": { "type": "boolean", "description": "是否启用支付宝自动打款和查单；启用时 withdrawals 必须同时开启。" }
      }
    },
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productionApiOrigin"],
      "properties": {
        "productionApiOrigin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/]+$",
          "description": "线上 API 根地址，只写协议和域名，不要带结尾斜杠或 /api 路径。",
          "examples": ["https://api.example.com"]
        }
      }
    },
    "advertising": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gromore"],
      "properties": {
        "gromore": {
          "type": "object",
          "additionalProperties": false,
          "required": ["appId", "splashPlacementId", "feedPlacementId", "fullScreenPlacementId", "rewardPlacementId"],
          "properties": {
            "appId": { "type": "string", "pattern": "^\\d+$", "description": "穿山甲/GroMore 应用 ID，不是代码包名。" },
            "splashPlacementId": { "type": "string", "pattern": "^\\d+$", "description": "开屏广告位 ID。" },
            "feedPlacementId": { "type": "string", "pattern": "^\\d+$", "description": "信息流广告位 ID。" },
            "fullScreenPlacementId": { "type": "string", "pattern": "^\\d+$", "description": "全屏/插屏广告位 ID。" },
            "rewardPlacementId": { "type": "string", "pattern": "^\\d+$", "description": "激励视频广告位 ID，任务激励和短剧解锁目前共用此广告位。" }
          }
        }
      }
    }
  }
}
